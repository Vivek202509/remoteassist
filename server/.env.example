# Copy to .env and adjust. The server reads plain process.env; use a loader
# (e.g. `node --env-file=.env src/server.js` on Node 20+) or export these.

PORT=8080

# TURN / coturn — must match infra/turnserver.conf static-auth-secret
TURN_HOST=turn.yourdomain.com
TURN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TURN_TTL_SEC=3600
TURN_STUN_PORT=3478
TURN_TLS_PORT=5349

# Session lifetimes (ms)
SESSION_CODE_TTL_MS=300000
PENDING_WAKE_TTL_MS=60000

# FCM wake — requires `npm i firebase-admin` and GOOGLE_APPLICATION_CREDENTIALS
# pointing at a service-account JSON. Leave false for local/dev.
FCM_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
