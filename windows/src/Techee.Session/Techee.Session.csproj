<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The composition root for a Windows host session. This is the only project that
       sees both the capture pipeline and the transport, which is what lets
       Techee.Windows.Host stay free of WebRTC and signaling types. -->
  <ItemGroup>
    <ProjectReference Include="..\Techee.Crypto\Techee.Crypto.csproj" />
    <ProjectReference Include="..\Techee.Protocol\Techee.Protocol.csproj" />
    <ProjectReference Include="..\Techee.Signaling\Techee.Signaling.csproj" />
    <ProjectReference Include="..\Techee.Store\Techee.Store.csproj" />
    <ProjectReference Include="..\Techee.WebRtc\Techee.WebRtc.csproj" />
    <ProjectReference Include="..\Techee.Windows.Host\Techee.Windows.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Techee.Session.Tests" />
  </ItemGroup>

</Project>
