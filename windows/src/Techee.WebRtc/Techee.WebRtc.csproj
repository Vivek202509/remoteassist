<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Techee.Protocol\Techee.Protocol.csproj" />
    <ProjectReference Include="..\Techee.Crypto\Techee.Crypto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recovery policy is driven by SIPSorcery connection-state callbacks. Exposing
         the handler to the tests is what lets them prove single-flight recovery without
         a real network failure. -->
    <InternalsVisibleTo Include="Techee.WebRtc.Tests" />
    <InternalsVisibleTo Include="Techee.Session.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
